  <md:Disease rdf:about="http://example.org/mediguide#Disease_Bronchitis">
    <md:requiresTest>
      <md:DiagnosticTest rdf:about="http://example.org/mediguide#Test_Chest_X_Ray">
        <md:value>Chest X-Ray</md:value>
        <rdfs:label xml:lang="en">Chest X-Ray</rdfs:label>
      </md:DiagnosticTest>
    </md:requiresTest>
    <md:requiresTest rdf:resource="http://example.org/mediguide#Test_CBC"/>
    <md:hasPrecaution rdf:resource="http://example.org/mediguide#Precaution_Rest_and_stay_hydrated"/>
    <md:hasPrecaution>
      <md:Precaution rdf:about="http://example.org/mediguide#Precaution_Use_a_humidifier">
        <md:value>Use a humidifier</md:value>
