      </md:Hospital>
    </md:availableAt>
    <md:requiresTest>
      <md:DiagnosticTest rdf:about="http://example.org/mediguide#Test_Clinical_Diagnosis">
        <md:value>Clinical Diagnosis</md:value>
        <rdfs:label xml:lang="en">Clinical Diagnosis</rdfs:label>
      </md:DiagnosticTest>
    </md:requiresTest>
    <md:hasPrecaution>
      <md:Precaution rdf:about="http://example.org/mediguide#Precaution_Rest_and_stay_hydrated">
        <md:value>Rest and stay hydrated</md:value>
