<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:md="http://example.org/mediguide#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <owl:Class rdf:about="http://example.org/mediguide#Precaution">
    <rdfs:comment xml:lang="en">Represents preventive measures and care instructions</rdfs:comment>
    <rdfs:label xml:lang="en">Precaution</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/mediguide#DiagnosticTest">
    <rdfs:comment xml:lang="en">Represents a clinical or diagnostic laboratory test</rdfs:comment>
    <rdfs:label xml:lang="en">Diagnostic Test</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/mediguide#Hospital">
    <rdfs:comment xml:lang="en">Represents a healthcare facility or hospital</rdfs:comment>
    <rdfs:label xml:lang="en">Hospital</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/mediguide#Specialist">
    <rdfs:comment xml:lang="en">Represents a medical specialist or doctor</rdfs:comment>
    <rdfs:label xml:lang="en">Specialist</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/mediguide#Disease">
    <rdfs:comment xml:lang="en">Represents a medical condition or disease</rdfs:comment>
    <rdfs:label xml:lang="en">Disease</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://example.org/mediguide#hasPrecaution">
    <rdfs:comment xml:lang="en">Links a disease to recommended precautions</rdfs:comment>
    <rdfs:label xml:lang="en">has precaution</rdfs:label>
    <rdfs:range rdf:resource="http://example.org/mediguide#Precaution"/>
    <rdfs:domain rdf:resource="http://example.org/mediguide#Disease"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/mediguide#requiresTest">
    <rdfs:comment xml:lang="en">Links a disease to recommended diagnostic tests</rdfs:comment>
    <rdfs:label xml:lang="en">requires test</rdfs:label>
    <rdfs:range rdf:resource="http://example.org/mediguide#DiagnosticTest"/>
    <rdfs:domain rdf:resource="http://example.org/mediguide#Disease"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/mediguide#availableAt">
    <rdfs:comment xml:lang="en">Links a disease to hospitals offering treatment</rdfs:comment>
    <rdfs:label xml:lang="en">available at</rdfs:label>
    <rdfs:range rdf:resource="http://example.org/mediguide#Hospital"/>
    <rdfs:domain rdf:resource="http://example.org/mediguide#Disease"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://example.org/mediguide#treatedBy">
    <rdfs:comment xml:lang="en">Links a disease to a medical specialist</rdfs:comment>
    <rdfs:label xml:lang="en">treated by</rdfs:label>
    <rdfs:range rdf:resource="http://example.org/mediguide#Specialist"/>
    <rdfs:domain rdf:resource="http://example.org/mediguide#Disease"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/mediguide#value">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://example.org/mediguide#name">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/mediguide#Disease"/>
  </owl:DatatypeProperty>
  <md:Disease rdf:about="http://example.org/mediguide#Disease_Migraine">
    <md:hasPrecaution>
      <md:Precaution rdf:about="http://example.org/mediguide#Precaution_Avoid_triggers_like_bright_light">
        <md:value>Avoid triggers like bright light</md:value>
        <rdfs:label xml:lang="en">Avoid triggers like bright light</rdfs:label>
      </md:Precaution>
    </md:hasPrecaution>
    <md:hasPrecaution>
      <md:Precaution rdf:about="http://example.org/mediguide#Precaution_Rest_in_a_dark_quiet_room">
        <md:value>Rest in a dark quiet room</md:value>
        <rdfs:label xml:lang="en">Rest in a dark quiet room</rdfs:label>
      </md:Precaution>
    </md:hasPrecaution>
    <md:hasPrecaution>
      <md:Precaution rdf:about="http://example.org/mediguide#Precaution_Stay_hydrated">
        <md:value>Stay hydrated</md:value>
        <rdfs:label xml:lang="en">Stay hydrated</rdfs:label>
      </md:Precaution>
    </md:hasPrecaution>
    <md:requiresTest>
      <md:DiagnosticTest rdf:about="http://example.org/mediguide#Test_EEG">
        <md:value>EEG</md:value>
        <rdfs:label xml:lang="en">EEG</rdfs:label>
      </md:DiagnosticTest>
    </md:requiresTest>
    <rdfs:label xml:lang="en">Migraine</rdfs:label>
    <md:hasPrecaution>
      <md:Precaution rdf:about="http://example.org/mediguide#Precaution_Take_prescribed_migraine_medication">
        <md:value>Take prescribed migraine medication</md:value>
        <rdfs:label xml:lang="en">Take prescribed migraine medication</rdfs:label>
      </md:Precaution>
    </md:hasPrecaution>
    <md:requiresTest>
      <md:DiagnosticTest rdf:about="http://example.org/mediguide#Test_CT_Scan_Brain">
        <md:value>CT Scan Brain</md:value>
        <rdfs:label xml:lang="en">CT Scan Brain</rdfs:label>
      </md:DiagnosticTest>
    </md:requiresTest>
    <md:name>Migraine</md:name>
    <md:requiresTest>
      <md:DiagnosticTest rdf:about="http://example.org/mediguide#Test_MRI_Brain">
        <md:value>MRI Brain</md:value>
        <rdfs:label xml:lang="en">MRI Brain</rdfs:label>
      </md:DiagnosticTest>
    </md:requiresTest>
    <md:treatedBy>
      <md:Specialist rdf:about="http://example.org/mediguide#Specialist_General_Physician">
        <md:value>General Physician</md:value>
        <rdfs:label xml:lang="en">General Physician</rdfs:label>
      </md:Specialist>
    </md:treatedBy>
    <md:treatedBy>
      <md:Specialist rdf:about="http://example.org/mediguide#Specialist_Neurologist">
        <md:value>Neurologist</md:value>
        <rdfs:label xml:lang="en">Neurologist</rdfs:label>
      </md:Specialist>
    </md:treatedBy>
    <md:availableAt>
      <md:Hospital rdf:about="http://example.org/mediguide#Hospital_NIMHANS">
        <md:value>NIMHANS</md:value>
        <rdfs:label xml:lang="en">NIMHANS</rdfs:label>
      </md:Hospital>
    </md:availableAt>
    <md:availableAt>
      <md:Hospital rdf:about="http://example.org/mediguide#Hospital_Apollo_Hospitals">
        <md:value>Apollo Hospitals</md:value>
        <rdfs:label xml:lang="en">Apollo Hospitals</rdfs:label>
      </md:Hospital>
    </md:availableAt>
    <md:availableAt>
      <md:Hospital rdf:about="http://example.org/mediguide#Hospital_Fortis_Neurology">
        <md:value>Fortis Neurology</md:value>
        <rdfs:label xml:lang="en">Fortis Neurology</rdfs:label>
      </md:Hospital>
    </md:availableAt>
  </md:Disease>
  <md:Disease rdf:about="http://example.org/mediguide#Disease_Vertigo">
    <md:availableAt rdf:resource="http://example.org/mediguide#Hospital_NIMHANS"/>
    <md:treatedBy rdf:resource="http://example.org/mediguide#Specialist_Neurologist"/>
    <rdfs:label xml:lang="en">Vertigo</rdfs:label>
    <md:availableAt rdf:resource="http://example.org/mediguide#Hospital_Apollo_Hospitals"/>
