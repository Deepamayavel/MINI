      </md:Precaution>
    </md:hasPrecaution>
    <md:requiresTest>
      <md:DiagnosticTest rdf:about="http://example.org/mediguide#Test_CBC">
        <md:value>CBC</md:value>
        <rdfs:label xml:lang="en">CBC</rdfs:label>
      </md:DiagnosticTest>
    </md:requiresTest>
    <rdfs:label xml:lang="en">Measles</rdfs:label>
    <md:treatedBy rdf:resource="http://example.org/mediguide#Specialist_General_Physician"/>
    <md:availableAt rdf:resource="http://example.org/mediguide#Hospital_Apollo_Hospitals"/>
    <md:requiresTest>
      <md:DiagnosticTest rdf:about="http://example.org/mediguide#Test_Measles_IgM_Antibody_Test">
        <md:value>Measles IgM Antibody Test</md:value>
