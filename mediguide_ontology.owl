        <md:value>Take prescribed vestibular medication</md:value>
        <rdfs:label xml:lang="en">Take prescribed vestibular medication</rdfs:label>
      </md:Precaution>
    </md:hasPrecaution>
    <md:requiresTest>
      <md:DiagnosticTest rdf:about="http://example.org/mediguide#Test_Audiometry">
        <md:value>Audiometry</md:value>
        <rdfs:label xml:lang="en">Audiometry</rdfs:label>
      </md:DiagnosticTest>
    </md:requiresTest>
    <md:hasPrecaution>
      <md:Precaution rdf:about="http://example.org/mediguide#Precaution_Avoid_sudden_head_movements">
        <md:value>Avoid sudden head movements</md:value>
        <rdfs:label xml:lang="en">Avoid sudden head movements</rdfs:label>
      </md:Precaution>
    </md:hasPrecaution>
    <md:requiresTest>
      <md:DiagnosticTest rdf:about="http://example.org/mediguide#Test_ENG_Test">
        <md:value>ENG Test</md:value>
        <rdfs:label xml:lang="en">ENG Test</rdfs:label>
      </md:DiagnosticTest>
    </md:requiresTest>
    <md:hasPrecaution>
      <md:Precaution rdf:about="http://example.org/mediguide#Precaution_Do_Epley_maneuver_exercises">
        <md:value>Do Epley maneuver exercises</md:value>
        <rdfs:label xml:lang="en">Do Epley maneuver exercises</rdfs:label>
      </md:Precaution>
    </md:hasPrecaution>
    <md:availableAt rdf:resource="http://example.org/mediguide#Hospital_Fortis_Neurology"/>
    <md:hasPrecaution>
      <md:Precaution rdf:about="http://example.org/mediguide#Precaution_Avoid_driving_during_episodes">
        <md:value>Avoid driving during episodes</md:value>
        <rdfs:label xml:lang="en">Avoid driving during episodes</rdfs:label>
      </md:Precaution>
    </md:hasPrecaution>
    <md:name>Vertigo</md:name>
    <md:requiresTest rdf:resource="http://example.org/mediguide#Test_MRI_Brain"/>
  </md:Disease>
  <md:Disease rdf:about="http://example.org/mediguide#Disease_Measles">
