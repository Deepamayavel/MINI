        <rdfs:label xml:lang="en">Monitor platelet count</rdfs:label>
      </md:Precaution>
    </md:hasPrecaution>
    <md:availableAt rdf:resource="http://example.org/mediguide#Hospital_Government_General_Hospital"/>
  </md:Disease>
